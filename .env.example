# -----------------------------------------------------------------------------
# Branchement sur le service LLM central : ~/mes_projets/Projet-IA/LLM-Service
#
# Ce projet est une app `uv` locale (pas de docker-compose), donc le "cas
# particulier" du doc `LLM-Service/docs/brancher-un-projet.md` : on tape
# l'endpoint OpenAI-compatible publie sur l'hote.
#
# Prerequis : le central tourne (voir son README) et liste "chat" :
#   curl -s -H "Authorization: Bearer <cle>" http://127.0.0.1:8080/v1/models
# -----------------------------------------------------------------------------

# Depuis l'hote (cas normal) :
INV_LLM_BASE_URL=http://127.0.0.1:8080/v1
# Depuis un conteneur attache au reseau externe llm-net :
# INV_LLM_BASE_URL=http://llm-central:8080/v1

# Defaut universel du parc pour le chat (remplace l'ancien gemma4:e4b/Ollama).
INV_LLM_MODEL=chat

# Obligatoire : valeur de LITELLM_MASTER_KEY du service central (voir son .env,
# non suivi par git). Ne jamais commiter la vraie valeur ici.
INV_LLM_API_KEY=sk-local-...

# -----------------------------------------------------------------------------
# Branchement sur le service LLM central : ~/mes_projets/llm-service
#
# Ce projet est une app `uv` locale (pas de docker-compose), donc le "cas
# particulier" du doc `llm-service/docs/brancher-un-projet.md` : on tape
# l'endpoint OpenAI-compatible publie sur l'hote.
#
# Prerequis : le central tourne  ->  cd ~/mes_projets/llm-service && make up
# -----------------------------------------------------------------------------

# Depuis l'hote (cas normal) :
INV_LLM_BASE_URL=http://localhost:11434/v1
# Depuis un conteneur attache au reseau llm-net :
# INV_LLM_BASE_URL=http://ollama-central:11434/v1

# Defaut universel du parc. Verifier sa presence : make models (dans llm-service)
INV_LLM_MODEL=gemma4:e4b

# Ollama ignore la valeur, mais l'en-tete Authorization doit exister.
INV_LLM_API_KEY=ollama
